# Local development secrets. Copy this file to ".dev.vars" (which is
# gitignored) and fill in a value. These are used only by `npm run dev`.
#
# In production, SESSION_SECRET is a real Worker secret, set once with:
#   npx wrangler secret put SESSION_SECRET
# It is never read from this file or committed to the repo.

# HMAC key used to sign session tokens. Use at least 32 characters locally too.
SESSION_SECRET=local-dev-secret-change-me-at-least-32-chars
